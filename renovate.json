{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Group assistant-ui packages — they are version-coupled and must be bumped together",
      "matchPackageNames": ["@assistant-ui/react", "@assistant-ui/core", "@assistant-ui/store", "@assistant-ui/tap", "assistant-stream"],
      "groupName": "assistant-ui"
    },
    {
      "description": "Queue non-major updates for Mergify",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
