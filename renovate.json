{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Group assistant-ui packages — they are version-coupled and must be bumped together",
      "matchPackageNames": ["@assistant-ui/react", "@assistant-ui/core", "@assistant-ui/store", "@assistant-ui/tap", "assistant-stream"],
      "groupName": "assistant-ui"
    },
    {
      "description": "Queue non-major updates for Mergify, except the locally patched AG-UI adapter",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "excludePackageNames": ["@assistant-ui/react-ag-ui"],
      "addLabels": ["automerge"]
    },
    {
      "description": "The local pnpm patch for @assistant-ui/react-ag-ui must be re-validated on every bump",
      "matchPackageNames": ["@assistant-ui/react-ag-ui"],
      "automerge": false
    },
    {
      "description": "determinator 0.12 (xtask) takes guppy 0.17's PackageGraph; a newer guppy breaks the build until determinator moves",
      "matchPackageNames": ["guppy"],
      "allowedVersions": "<0.18"
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
