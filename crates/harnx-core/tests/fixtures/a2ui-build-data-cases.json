[
  {
    "name": "maps inputs and resolves action context",
    "surface": {
      "version": "1.0",
      "createSurface": {
        "dataModel": {
          "choice": [],
          "name": "",
          "region": "eu"
        },
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          {
            "id": "col",
            "component": "Column",
            "children": ["title", "choice", "name", "submit_label", "submit"]
          },
          { "id": "title", "component": "Text", "text": "Pick a deployment target" },
          {
            "id": "choice",
            "component": "ChoicePicker",
            "variant": "mutuallyExclusive",
            "options": [
              { "label": "Staging", "value": "staging" },
              { "label": "Production", "value": "prod" }
            ],
            "value": { "@path": "/choice" }
          },
          {
            "id": "name",
            "component": "TextField",
            "label": "Release name",
            "value": { "@path": "/name" }
          },
          { "id": "submit_label", "component": "Text", "text": "Deploy" },
          {
            "id": "submit",
            "component": "Button",
            "child": "submit_label",
            "action": {
              "event": {
                "name": "deploy",
                "context": {
                  "choice": { "@path": "/choice" },
                  "mode": "fast",
                  "region": { "@path": "/region" }
                }
              }
            }
          }
        ]
      }
    },
    "action": "deploy",
    "values": {
      "choice": ["prod"],
      "name": "rel-1"
    },
    "expected": {
      "choice": ["prod"],
      "name": "rel-1",
      "mode": "fast",
      "region": "eu"
    }
  },
